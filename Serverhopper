local function pingColor(ping)
    ping = tonumber(ping) or 0
    if ping <= 0 then return Color3.fromRGB(180, 180, 180) end
    if ping < 100 then return Color3.fromRGB(100, 255, 150) end
    if ping < 200 then return Color3.fromRGB(255, 220, 100) end
    return Color3.fromRGB(255, 100, 100)
end

