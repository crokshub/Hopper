local ordensOpts = {
    { label = "MENOS PLAYERS", key = "playing" },
    { label = "MENOR PING",    key = "ping" },
    { label = "MAIS RECENTE",  key = "id" }, -- server novo = id lexicográfico maior
}
local ordemIdx = 1

local function ordenarLista(lista)
    local key = ordensOpts[ordemIdx].key
    table.sort(lista, function(a, b)
        if key == "playing" then return a.playing < b.playing end
        if key == "ping" then
            local pa = (a.ping > 0) and a.ping or 9999
            local pb = (b.ping > 0) and b.ping or 9999
            return pa < pb
        end
        if key == "id" then return a.id > b.id end
        return a.playing < b.playing
    end)
    return lista
end

local function fetchServers(maxPing)
    maxPing = maxPing or 9999
    local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local ok, raw = pcall(function() return game:HttpGet(url) end)
    if not ok or not raw or raw == "" then return nil end
    local ok2, data = pcall(HttpService.JSONDecode, HttpService, raw)
    if not ok2 or not data or not data.data then return nil end
    local currentId = tostring(game.JobId)
    local lista = {}
    for _, s in ipairs(data.data) do
        local ping = s.ping or 0
        if s.id and tostring(s.id) ~= currentId
           and (s.playing or 0) < (s.maxPlayers or 0)
           and (maxPing >= 9999 or ping <= 0 or ping <= maxPing) then
            table.insert(lista, {
                id = tostring(s.id),
                playing = s.playing or 0,
                maxPlayers = s.maxPlayers or 0,
                ping = ping,
                region = s.region or nil
            })
        end
    end
    return ordenarLista(lista)
end

-- Verificação item 9: re-check de vaga e ping
local function verificarVaga(serverId, maxPing)
    maxPing = maxPing or 9999
    local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local ok, raw = pcall(function() return game:HttpGet(url) end)
    if not ok or not raw then return false, nil, "http" end
    local ok2, data = pcall(HttpService.JSONDecode, HttpService, raw)
    if not ok2 or not data or not data.data then return false, nil, "json" end
    for _, s in ipairs(data.data) do
        if tostring(s.id) == tostring(serverId) then
            local playing = s.playing or 0
            local maxP = s.maxPlayers or 0
            local ping = s.ping or 0
            if playing >= maxP then return false, nil, "cheio" end
            if maxPing < 9999 and ping > 0 and ping > maxPing then
                return false, nil, "ping_alto"
            end
            return true, {
                id = tostring(s.id),
                playing = playing,
                maxPlayers = maxP,
                ping = ping,
                region = s.region or nil
            }, "ok"
        end
    end
    return false, nil, "sumiu"
end

-- Tentar teleport em vários candidatos
local function tentarTeleport(lista, maxTentativas, maxPing)
    maxTentativas = maxTentativas or 5
    local tentativas = 0
    local motivos = {}
    for _, s in ipairs(lista) do
        if tentativas >= maxTentativas then break end
        tentativas = tentativas + 1

        local temVaga, dados, motivo = verificarVaga(s.id, maxPing)
        if temVaga and dados then
            mostrarNotif("Tentando " .. tentativas .. ": " .. dados.playing .. "/" .. dados.maxPlayers, 1.5)
            local ok = pcall(function()
                TeleportService:TeleportToPlaceInstance(PlaceId, dados.id, LocalPlayer)
            end)
            if ok then return true, dados end
            table.insert(motivos, "tp_fail")
            task.wait(0.6)
        else
            table.insert(motivos, motivo or "?")
        end
    end
    return false, nil, motivos
end

