local function getAmigos()
    local amigos = {}
    local cursor = ""
    for i = 1, 4 do
        local url = "https://friends.roblox.com/v1/users/" .. LocalPlayer.UserId .. "/friends?limit=50"
        if cursor ~= "" then url = url .. "&cursor=" .. cursor end
        local ok, raw = pcall(function() return game:HttpGet(url) end)
        if not ok or not raw or raw == "" then break end
        local ok2, data = pcall(HttpService.JSONDecode, HttpService, raw)
        if not ok2 or not data or not data.data then break end
        for _, a in ipairs(data.data) do
            table.insert(amigos, { id = a.id, name = a.name, display = a.displayName })
        end
        cursor = data.nextPageCursor
        if not cursor or cursor == "" then break end
    end
    return amigos
end

local function getPresencas(userIds)
    if #userIds == 0 then return {} end
    local ok, raw = pcall(function()
        return game:HttpPost("https://presence.roblox.com/v1/presence/users",
            HttpService:JSONEncode({ userIds = userIds }))
    end)
    if not ok or not raw or raw == "" then return {} end
    local ok2, data = pcall(HttpService.JSONDecode, HttpService, raw)
    if not ok2 or not data or not data.userPresences then return {} end
    local map = {}
    for _, p in ipairs(data.userPresences) do
        map[p.userId] = p
    end
    return map
end

