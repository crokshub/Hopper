        amigosStatus.Text = "✗ Não consegui buscar. HTTP Requests ligado?"
        amigosStatus.TextColor3 = Color3.fromRGB(255, 100, 100)
        TAmigos.Text = "🔎 BUSCAR AMIGOS NO JOGO"
        return
    end

    local ids = {}
    for _, a in ipairs(amigos) do table.insert(ids, a.id) end

    local presencas = {}
    for i = 1, #ids, 50 do
        local bloco = {}
        for j = i, math.min(i + 49, #ids) do
            table.insert(bloco, ids[j])
        end
        local map = getPresencas(bloco)
        for k, v in pairs(map) do presencas[k] = v end
    end

    local noJogo = {}
    for _, a in ipairs(amigos) do
        local p = presencas[a.id]
        if p and p.userPresenceType == 2 and p.placeId == PlaceId then
            table.insert(noJogo, {
                id = a.id,
                name = a.name,
                display = a.display,
                gameId = p.gameId,
                lastLocation = p.lastLocation
            })
        end
    end

    if #noJogo == 0 then
        amigosStatus.Text = "Nenhum amigo no jogo agora (" .. #amigos .. " checados)."
        amigosStatus.TextColor3 = Color3.fromRGB(255, 200, 50)
        TAmigos.Text = "🔎 BUSCAR AMIGOS NO JOGO"
        return
    end

    amigosStatus.Text = "✓ " .. #noJogo .. " amigo(s) no jogo. Clica JOIN."
    amigosStatus.TextColor3 = Color3.fromRGB(100, 255, 150)
    TAmigos.Text = "🔎 BUSCAR AMIGOS NO JOGO"

    for i, a in ipairs(noJogo) do
        local row = Instance.new("Frame", amigosList)
        row.Size = UDim2.new(1, 0, 0, 44); row.Position = UDim2.new(0, 0, 0, (i-1) * 48)
        row.BackgroundColor3 = COR_BG_BTN; row.BorderSizePixel = 0
        row.ZIndex = 11
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
        local rowStroke = Instance.new("UIStroke", row)
        rowStroke.Color = Color3.fromRGB(120, 200, 255); rowStroke.Thickness = 1; rowStroke.Transparency = 0.3

        local nome = Instance.new("TextLabel", row)
        nome.Size = UDim2.new(1, -80, 0, 18); nome.Position = UDim2.new(0, 10, 0, 5)
        nome.BackgroundTransparency = 1
        nome.Text = a.display ~= "" and (a.display .. " (@" .. a.name .. ")") or a.name
        nome.TextColor3 = Color3.fromRGB(255, 255, 255)
        nome.Font = Enum.Font.GothamBold; nome.TextSize = 11
        nome.TextXAlignment = Enum.TextXAlignment.Left; nome.ZIndex = 12

        local loc = Instance.new("TextLabel", row)
        loc.Size = UDim2.new(1, -80, 0, 14); loc.Position = UDim2.new(0, 10, 0, 23)
        loc.BackgroundTransparency = 1
        loc.Text = "🎮 " .. (a.lastLocation or "?")
        loc.TextColor3 = Color3.fromRGB(150, 200, 255)
        loc.Font = Enum.Font.Gotham; loc.TextSize = 10
        loc.TextXAlignment = Enum.TextXAlignment.Left; loc.ZIndex = 12

        local jb = Instance.new("TextButton", row)
        jb.Size = UDim2.new(0, 58, 0, 30); jb.Position = UDim2.new(1, -66, 0.5, -15)
        jb.BackgroundColor3 = COR_ON; jb.BorderSizePixel = 0
        jb.Text = "JOIN"; jb.TextColor3 = Color3.fromRGB(255, 255, 255)
        jb.Font = Enum.Font.GothamBlack; jb.TextSize = 11
        jb.AutoButtonColor = false; jb.ZIndex = 12
        Instance.new("UICorner", jb).CornerRadius = UDim.new(0, 5)
        local jbS = Instance.new("UIStroke", jb)
        jbS.Color = COR_ON_STROKE; jbS.Thickness = 1; jbS.Transparency = 0.3

        jb.MouseButton1Click:Connect(function()
            if not a.gameId or a.gameId == "" then
                mostrarNotif("Sem gameId. Amigo em outro server.", 2)
                return
            end
            jb.Text = "..."
            jb.BackgroundColor3 = Color3.fromRGB(255, 200, 50)
            mostrarNotif("Entrando no server do " .. a.name .. "...", 1.5)
            local ok = pcall(function()
                TeleportService:TeleportToPlaceInstance(PlaceId, a.gameId, LocalPlayer)
            end)
            if not ok then
                jb.Text = "ERRO"
                jb.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
                task.wait(1.5)
                jb.Text = "JOIN"
                jb.BackgroundColor3 = COR_ON
            end
        end)
    end
    amigosList.Size = UDim2.new(1, -10, 0, #noJogo * 48)
end)

