local autoEnabled = false
local autoThread = nil

local function pegarLimite()
    return math.max(1, math.floor(tonumber(maxPlayersBox.Text) or 3))
end

local function joinMelhor()
    local limite = pegarLimite()
    local count = #Players:GetPlayers()

    if count <= limite then
        statusLabel.Text = "✓ Server atual tem " .. count .. " player(s)."
        statusLabel.TextColor3 = Color3.fromRGB(100, 255, 150)
        return false
    end

    local lista = fetchServers()
    if not lista or #lista == 0 then
        statusLabel.Text = "✗ Nenhum server com vaga."
        statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return false
    end

    local filtrada = aplicarFiltro(lista)
    if #filtrada == 0 then filtrada = lista end

    statusLabel.Text = "Tentando top 5 candidatos..."
    statusLabel.TextColor3 = Color3.fromRGB(120, 180, 255)

    local ok = tentarTeleport(filtrada, 5)
    return ok
end

BtnAuto.MouseButton1Click:Connect(function()
    autoEnabled = not autoEnabled
    setBtnOn(BtnAuto, SAuto, autoEnabled)
    TAuto.Text = "AUTO JOIN: " .. (autoEnabled and "ON" or "OFF")

    if autoEnabled then
        mostrarNotif("Auto Join ligado", 1.5)
        autoThread = task.spawn(function()
            while autoEnabled and ScreenGui.Parent do
                local limite = pegarLimite()
                local count = #Players:GetPlayers()
                if count <= limite then
                    statusLabel.Text = "✓ " .. count .. " players. Aguardando..."
                    statusLabel.TextColor3 = Color3.fromRGB(100, 255, 150)
                    task.wait(3)
                else
                    joinMelhor()
                    task.wait(8)
                end
            end
        end)
    else
        if autoThread then task.cancel(autoThread); autoThread = nil end
        statusLabel.Text = "Auto Join parado."
        statusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
    end
end)

